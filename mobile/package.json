{
  "name": "yuhmyuhm-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Yuhmyuhm Catering Services - Android mobile app (Expo + React Native + TypeScript). Standalone project; intentionally NOT part of the root npm workspaces.",
  "main": "index.ts",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "doctor": "npx --yes expo-doctor@latest",
    "validate": "expo config --type public",
    "build:preview": "npx eas-cli build --platform android --profile preview",
    "assets:placeholder": "node scripts/generate-placeholder-assets.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@supabase/supabase-js": "^2.117.2",
    "babel-preset-expo": "~57.0.13",
    "expo": "~57.0.26",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
