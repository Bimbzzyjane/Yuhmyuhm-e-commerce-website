# ===========================================================================
# mobile/.env.example  ->  copy to mobile/.env
# ===========================================================================
#   cp mobile/.env.example mobile/.env
#
# PUBLIC VALUES ONLY. Expo inlines every EXPO_PUBLIC_* value into the app
# bundle at build time, so anything here can be read out of a shipped APK.
#
# NEVER put a server secret in this file. In particular, none of these belong
# here: the Supabase service-role / secret key, any Mailgun API credential,
# the Google OAuth client secret, the direct database connection string, or any
# backend-only rate-limit / business-rule configuration. Those live only in
# backend/.env (which is gitignored) and never leave the API process.
#
# The two Supabase values below are the SAME public project URL and publishable
# key the website already ships to browsers (frontend/.env.local). They are
# public by design and guarded by Row Level Security.
#
# ---------------------------------------------------------------------------
# CLOUD BUILDS (EAS) - READ THIS
# ---------------------------------------------------------------------------
# This file is only for LOCAL development. A local `.env` is gitignored, so it is
# NOT uploaded to EAS Build and the APK would come out unconfigured.
#
# For the preview APK, set these same four variables as EAS environment
# variables in the `preview` environment instead (values are public, so
# `plaintext` visibility is appropriate):
#
#   eas env:create --name EXPO_PUBLIC_API_URL        --value https://api.yourdomain.com --environment preview --visibility plaintext
#   eas env:create --name EXPO_PUBLIC_SUPABASE_URL   --value https://<ref>.supabase.co      --environment preview --visibility plaintext
#   eas env:create --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value <publishable key>            --environment preview --visibility plaintext
#   eas env:create --name EXPO_PUBLIC_STOREFRONT_URL --value https://your-storefront.vercel.app --environment preview --visibility plaintext
#
# The deployed API is HTTPS, so the preview APK needs no cleartext-traffic
# exception. The `http://` examples below are for local development only.
# ===========================================================================


# Base URL of the EXISTING Express commerce API (no trailing slash — one is
# tolerated if you paste it, it is trimmed at runtime).
# This app never talks to a second API.
#   Android emulator:         http://10.0.2.2:4000
#   Physical phone on Wi-Fi:  http://<dev-machine-LAN-IP>:4000
#   Deployed / preview APK:   https://api.yourdomain.com
# NOTE: `localhost` on a phone means the phone itself, so it will NOT work on a
# physical device.
EXPO_PUBLIC_API_URL=


# Supabase project URL (same project as the website).
EXPO_PUBLIC_SUPABASE_URL=


# Supabase publishable ("anon") key - public by design, protected by RLS.
# This is NOT a secret key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=


# Absolute origin of the existing Next.js storefront (no trailing slash).
# Catalogue images are returned by the API as relative paths such as
# /images/catalog/chocolate-delight-cake.jpg, which are served by the
# storefront's public/ directory - not by the API. This lets the app resolve
# them to an absolute URL.
#   local:      http://localhost:3000
#   production: https://your-storefront.vercel.app
EXPO_PUBLIC_STOREFRONT_URL=
