# ---------------------------------------------------------------------------
# backend/.env  -  copy from this file:  cp backend/.env.example backend/.env
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

# "memory" boots instantly with seeded demo data (no accounts needed).
# Switch to "supabase" once SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set.
BACKEND_DATA_BACKEND=memory

# Supabase (server-only). Leave blank while using the memory backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# "console" prints formatted emails to stdout. Use "mailgun" in production.
MAIL_TRANSPORT=console
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE=https://api.mailgun.net
EMAIL_FROM_NAME=Yuhmyuhm Catering Services
EMAIL_FROM_ADDRESS=orders@yuhmyuhm.com
EMAIL_ORDER_NOTIFICATION_TO=

# Business rules
DEFAULT_DELIVERY_FEE=5000
FREE_DELIVERY_THRESHOLD=150000
CURRENCY=NGN
MAX_ITEM_QUANTITY=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
