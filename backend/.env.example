# ===========================================================================
# backend/.env
# ===========================================================================
#   cp backend/.env.example backend/.env
#
# Every value below has a working default, so the API boots on seeded
# in-memory data with no keys at all. Fill in the blanks only when you want
# real persistence (Supabase) and real email (Mailgun).
#
# The full annotated reference (including the frontend variables) is the
# .env.example at the repository root.
# ===========================================================================

NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# memory = seeded in-process data (zero setup, resets on restart)
# supabase = real Postgres (needs the two SUPABASE_* values below)
BACKEND_DATA_BACKEND=memory


# --- Supabase: the database ------------------------------------------------
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres URI, for psql / migrations / backups only.
# The application itself does not read this.
DATABASE_URL=


# --- Google OAuth ----------------------------------------------------------
# Recorded here for completeness. Sign-in is handled by Supabase Auth, so
# these two values are NOT read by this process — they are entered in the
# Supabase dashboard:  Authentication -> Providers -> Google.
#
# Create them at Google Cloud Console -> APIs & Services -> Credentials ->
# Create OAuth client ID -> Web application:
#
#   Authorised JavaScript origin:  http://localhost:3000
#   Authorised redirect URI:       https://<project-ref>.supabase.co/auth/v1/callback
#
# Also add http://localhost:3000/auth/callback to Supabase -> Authentication ->
# URL Configuration -> Redirect URLs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# --- Mailgun: order confirmation emails ------------------------------------
# console = print to this process's stdout (default)
# mailgun = actually send
MAIL_TRANSPORT=console

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# EU-region domains: https://api.eu.mailgun.net
MAILGUN_API_BASE=https://api.mailgun.net

# Must be a verified sender domain in Mailgun. Blank falls back to
# orders@yuhmyuhm.com.
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME=Yuhmyuhm Catering Services

# Optional: also send a copy of every new order here.
EMAIL_ORDER_NOTIFICATION_TO=


# --- Business rules (major units, i.e. naira) ------------------------------
DEFAULT_DELIVERY_FEE=5000
FREE_DELIVERY_THRESHOLD=150000
CURRENCY=NGN
MAX_ITEM_QUANTITY=20

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# A separate, stricter budget for POST /api/orders only. Checkout is the one
# anonymous endpoint that writes a row, moves stock and sends an email, so it
# gets its own small allowance. Browsing and the cart are NOT affected by it.
CHECKOUT_RATE_LIMIT_WINDOW_MS=60000
CHECKOUT_RATE_LIMIT_MAX_REQUESTS=5

# How many reverse proxies sit in front of the API. This is what lets rate
# limiting see the REAL client address instead of the proxy's, so it must match
# the actual production topology:
#
#   0 -> no proxy: X-Forwarded-For is ignored. Correct for `npm run dev` and
#        for any host that reaches the API directly. Using 1 here would let a
#        caller forge the header and bypass the limiter entirely.
#   1 -> exactly one proxy in front (Vercel / Render / Railway edge). Default.
#   N -> N trusted proxies. Bounded to 10; a larger typo fails at boot rather
#        than silently trusting every hop.
TRUST_PROXY_HOPS=1

