# ===========================================================================
# Yuhmyuhm Catering Services - FULL environment reference (root)
# ===========================================================================
# This file documents EVERY variable used by the project.
#   - Copy backend/.env.example  -> backend/.env
#   - Copy frontend/.env.example -> frontend/.env.local
# Never commit the real .env files (they are git-ignored).
#
# Nothing here is required to run the app locally in "demo" mode: with
# BACKEND_DATA_BACKEND=memory and the console mail transport the API boots and
# all tests pass without Supabase / Google / Mailgun accounts.
# ===========================================================================


# ---------------------------------------------------------------------------
# BACKEND  (backend/.env)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000

# --- Data backend -----------------------------------------------------------
# "supabase" -> real Postgres via Supabase (production / staging)
# "memory"   -> in-process seeded store (local demo + automated tests)
BACKEND_DATA_BACKEND=memory

# --- Supabase ---------------------------------------------------------------
# Service-role key. SERVER ONLY. Bypasses RLS - never ship to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional. Legacy HS256 JWT secret; only needed if you prefer local JWT
# verification over the default server-side supabase.auth.getUser() check.
# SUPABASE_JWT_SECRET=

# --- Mailgun ----------------------------------------------------------------
# Transport: "mailgun" (real) or "console" (pretty-prints the email to stdout)
MAIL_TRANSPORT=console
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# EU accounts must use https://api.eu.mailgun.net
MAILGUN_API_BASE=https://api.mailgun.net
EMAIL_FROM_NAME=Yuhmyuhm Catering Services
EMAIL_FROM_ADDRESS=orders@yuhmyuhm.com
# Internal inbox that receives a copy of every new order (optional).
EMAIL_ORDER_NOTIFICATION_TO=

# --- Business rules ---------------------------------------------------------
DEFAULT_DELIVERY_FEE=5000
FREE_DELIVERY_THRESHOLD=150000
CURRENCY=NGN

# --- Ordering / limits ------------------------------------------------------
MAX_ITEM_QUANTITY=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120


# ---------------------------------------------------------------------------
# FRONTEND  (frontend/.env.local)
# ---------------------------------------------------------------------------
# Public API base URL (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Supabase *public* credentials. The anon key is designed to be public; every
# table is protected by RLS and all mutation happens through the Express API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute site URL used to build the OAuth redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
