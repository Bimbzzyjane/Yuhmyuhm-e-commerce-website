# ===========================================================================
# Yuhmyuhm Catering Services — FULL environment reference (root)
# ===========================================================================
# The one place that documents every variable the project uses.
#
#   1. cp backend/.env.example  backend/.env
#   2. cp frontend/.env.example frontend/.env.local
#   3. fill in the blank values
#
# Nothing here is required to run the project. With the defaults in place the
# API boots on seeded in-memory data and prints emails to the console, so
# browsing, the cart, checkout and the order confirmation all work end to end
# with no accounts at all. Add keys only when you want real sign-in, real
# persistence or real email.
#
# ---------------------------------------------------------------------------
# WHERE EACH KEY GOES
# ---------------------------------------------------------------------------
#   Supabase: database (server)   -> backend/.env
#                                     SUPABASE_URL
#                                     SUPABASE_SERVICE_ROLE_KEY
#
#   Supabase: browser session     -> frontend/.env.local
#                                     NEXT_PUBLIC_SUPABASE_URL
#                                     NEXT_PUBLIC_SUPABASE_ANON_KEY
#
#   Google OAuth                  -> the SUPABASE dashboard, not this app.
#                                     See the GOOGLE section below.
#
#   Mailgun                       -> backend/.env
#                                     MAILGUN_API_KEY
#                                     MAILGUN_DOMAIN
#                                     MAILGUN_FROM_EMAIL
#
#   Public URLs                   -> both, see NEXT_PUBLIC_SITE_URL + CORS_ORIGINS
#
# The two workspace files are subsets of this one:
#   backend/.env.example   -> what the API process reads
#   frontend/.env.example  -> what gets baked into the browser bundle
# ===========================================================================


# ===========================================================================
# 1. BACKEND  ->  backend/.env
# ===========================================================================

NODE_ENV=development
PORT=4000

# Browser origins allowed to call the API (comma separated, no trailing slash).
# Add your production storefront origin here when you deploy.
CORS_ORIGINS=http://localhost:3000

# Where the data lives.
#   memory   -> seeded in-process store. Zero setup, resets on restart.
#               This is what makes the project demoable and testable offline.
#   supabase -> real Postgres. Requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
BACKEND_DATA_BACKEND=memory

# Logging: info | debug | silent
LOG_LEVEL=info


# --- Supabase (the database) ----------------------------------------------
# Supabase dashboard -> Project Settings -> API
#   Project URL          -> SUPABASE_URL
#   service_role secret  -> SUPABASE_SERVICE_ROLE_KEY
#
# The service-role key bypasses Row Level Security. It is SERVER ONLY and must
# never be exposed to the browser, committed, or pasted into frontend code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string. Supabase dashboard -> Project Settings ->
# Database -> Connection string -> URI (it contains your database password).
#
# NOTE: the application does NOT read this variable. It is kept here so that
# psql, migrations and backups have one obvious place to find the connection
# string. The API talks to Supabase over its REST API using the two values
# above.
DATABASE_URL=


# --- Email + password sign-in ----------------------------------------------
# NO CONFIGURATION NEEDED. Email/password authentication is enabled by default
# in every Supabase project. As soon as frontend/.env.local has
# NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY, the sign-in and
# create-account pages at /auth/signin and /auth/signup work immediately.
#
# Optional: Supabase -> Authentication -> Email -> uncheck "Confirm email" if
# you want people to be signed in immediately after creating an account
# instead of after they click a confirmation link.


# --- Google OAuth ----------------------------------------------------------
# IMPORTANT: these two values are NOT read by this application. Sign-in is
# handled by Supabase Auth, so the Google credentials belong in the Supabase
# dashboard:
#
#   Supabase -> Authentication -> Providers -> Google -> enable, then paste
#   the Client ID and Client Secret.
#
# Create them at Google Cloud Console -> APIs & Services -> Credentials ->
# Create OAuth client ID -> Web application:
#
#   Authorised JavaScript origin:  http://localhost:3000
#                                  https://your-storefront.vercel.app
#   Authorised redirect URI:       https://<project-ref>.supabase.co/auth/v1/callback
#
# They are recorded here purely so the whole Google integration is documented
# in one place next to the Supabase keys it is used with.
GOOGLE_CLIENT_ID= 
GOOGLE_CLIENT_SECRET=


# --- Mailgun (order confirmation emails) ----------------------------------
# Transport:
#   console  -> pretty-prints the email to the API console. Default, no account.
#   mailgun  -> actually sends. Requires the three MAILGUN_* values below.
MAIL_TRANSPORT=console

# Mailgun dashboard -> Sending -> Domains -> your domain -> API keys
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# EU-region domains must use https://api.eu.mailgun.net
MAILGUN_API_BASE=https://api.mailgun.net

# The From header on every email we send. The domain must be one you have
# verified in Mailgun, otherwise sends are rejected.
# Blank falls back to orders@yuhmyuhm.com, which is fine until you send real
# mail.
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME=Yuhmyuhm Catering Services

# Optional. When set, every new order also sends a copy here, so the team does
# not have to watch the database.
EMAIL_ORDER_NOTIFICATION_TO=


# --- Business rules -------------------------------------------------------
# Major units (naira). The API converts to integer kobo internally.

# Flat delivery fee applied below the free-delivery threshold.
DEFAULT_DELIVERY_FEE=5000

# Subtotal at which delivery becomes free.
FREE_DELIVERY_THRESHOLD=150000

CURRENCY=NGN

# Most units of a single product allowed in one order.
MAX_ITEM_QUANTITY=20


# --- Abuse protection -----------------------------------------------------
# Global budget for the whole API (browsing included).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# A separate, stricter budget that applies to POST /api/orders ONLY. Checkout is
# the one anonymous endpoint that writes a row, moves stock and sends an email,
# so it is limited far more aggressively than browsing.
CHECKOUT_RATE_LIMIT_WINDOW_MS=60000
CHECKOUT_RATE_LIMIT_MAX_REQUESTS=5

# How many reverse proxies sit in front of the API. Rate limiting needs the REAL
# client address, so this must match the actual production topology:
#
#   0 -> no proxy: X-Forwarded-For is ignored. Use this for `npm run dev` and
#        for any host that reaches the API directly. Leaving it at 1 in that
#        situation would let a caller forge the header and bypass the limiter.
#   1 -> exactly one proxy in front (Vercel / Render / Railway edge). Default.
#   N -> N trusted proxies (bounded to 10; a larger value fails at boot).
TRUST_PROXY_HOPS=1


# ===========================================================================
# 2. FRONTEND  ->  frontend/.env.local
# ===========================================================================
# Everything in this section is inlined into the browser bundle at build time,
# so it must never contain a secret. The anon key below is public by design:
# it only grants what Row Level Security allows, and the storefront never reads
# or writes a table directly — all commerce data goes through the API.

# Base URL of the Express API (no trailing slash).
#   local:      http://localhost:4000
#   production: https://api.yourdomain.com
# Blank falls back to http://localhost:4000, which is what you want locally.
NEXT_PUBLIC_API_URL=

# Supabase dashboard -> Project Settings -> API
#   Project URL -> NEXT_PUBLIC_SUPABASE_URL
#   anon public -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# Leave both blank to run as a guest-only shop: browsing, cart and checkout all
# still work, and the sign-in button explains that it is not configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin of the storefront. Used to build the OAuth redirect target
# and the canonical metadata URLs.
#   local:      http://localhost:3000
#   production: https://your-storefront.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
