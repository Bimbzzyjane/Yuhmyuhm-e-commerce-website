{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Opt in explicitly. TypeScript 6/7 turns this on by default, and without it
    // a mistyped CSS/asset import (e.g. './global.css') passes silently. The
    // side-effect imports we rely on are declared in src/types/assets.d.ts.
    "noUncheckedSideEffectImports": true,

    "plugins": [{ "name": "next" }],

    // Declared alongside `paths` so the `@/*` alias is explicit. Some tool
    // schemas still expect `baseUrl` to be present when `paths` is used.
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
