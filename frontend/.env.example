# ---------------------------------------------------------------------------
# frontend/.env.local  -  copy from this file:
#   cp frontend/.env.example frontend/.env.local
# ---------------------------------------------------------------------------

# Express commerce API (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Supabase public credentials. Safe for the browser: the anon key only grants
# what Row Level Security allows, and the storefront never writes tables
# directly - all mutations go through the Express API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin, used to build the Google OAuth redirect target.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
