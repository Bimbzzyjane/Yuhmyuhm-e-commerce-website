# ===========================================================================
# frontend/.env.local
# ===========================================================================
#   cp frontend/.env.example frontend/.env.local
#
# IMPORTANT: Next.js inlines every NEXT_PUBLIC_* value into the browser bundle.
# Nothing in this file may be a secret. The Supabase anon key is public by
# design — Row Level Security is what protects the data, and the storefront
# never touches a table directly (all commerce data goes through the API).
#
# The API URL is already set for local development. Leave the two Supabase
# values blank to run as a guest-only shop: browsing, the cart, checkout and
# the order confirmation all still work.
# ===========================================================================

# Base URL of the Express API, no trailing slash.
#   local:      http://localhost:4000
#   production: https://api.yourdomain.com
# Blank falls back to http://localhost:4000, which is what you want locally.
NEXT_PUBLIC_API_URL=


# --- Supabase: browser session, used only for Google sign-in ---------------
# Supabase dashboard -> Project Settings -> API
#   Project URL   -> NEXT_PUBLIC_SUPABASE_URL
#   anon  public  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# --- Site origin -----------------------------------------------------------
# Used to build the OAuth redirect target and canonical metadata URLs.
#   local:      http://localhost:3000
#   production: https://your-storefront.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Where do the GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET go?
# ---------------------------------------------------------------------------
# Not here. Sign-in is handled by Supabase Auth, so they are entered in the
# Supabase dashboard:  Authentication -> Providers -> Google.
#
# Create them at Google Cloud Console -> APIs & Services -> Credentials:
#   Authorised JavaScript origin: http://localhost:3000
#   Authorised redirect URI:      https://<project-ref>.supabase.co/auth/v1/callback
#
# See the "Google OAuth" section of the root .env.example for the full steps.
# ---------------------------------------------------------------------------
